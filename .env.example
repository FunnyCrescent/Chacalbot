# ═══════════════════════════════════════════════════════════════
# TELEGRAM BOT
# ═══════════════════════════════════════════════════════════════
TELEGRAM_BOT_TOKEN=your-bot-token-here
ADMIN_CHAT_ID=-1001234567890

# ═══════════════════════════════════════════════════════════════
# LLM API (OpenAI-совместимый эндпоинт)
# ═══════════════════════════════════════════════════════════════
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://polza.ai/api/v1

# ═══════════════════════════════════════════════════════════════
# ПРОКСИ — чтобы не поднимать туннели
# ═══════════════════════════════════════════════════════════════
# Форматы URL:
#   http://host:port
#   http://user:pass@host:port
#   https://host:port
#   socks5://host:port            (DNS резолвится локально)
#   socks5h://host:port           (DNS через прокси — РЕКОМЕНДУЕТСЯ)
#   socks5://user:pass@host:port
#
# Логика резолва (по убыванию приоритета):
#   1. TELEGRAM_PROXY / OPENAI_PROXY  — точечно перекрывает GLOBAL
#   2. GLOBAL_PROXY                    — применяется и к TG, и к LLM
#   3. Системные env: ALL_PROXY > HTTPS_PROXY > HTTP_PROXY
#      (Hiddify/v2rayN/clash часто прописывают их сами при включении)
#   4. Прямое подключение
#
# Для SOCKS нужно один раз поставить:
#   pip install "httpx[socks]" aiohttp-socks
#
# ─── Hiddify / v2rayN на ПК ─────────────────────────────────────
# Типичные порты локального прокси-клиента:
#   10808 — SOCKS5  → GLOBAL_PROXY=socks5h://127.0.0.1:10808
#   10809 — HTTP    → GLOBAL_PROXY=http://127.0.0.1:10809
#   12334 — SOCKS5  (некоторые сборки v2rayN)
#   7890  — HTTP    (Clash)
#
# ─── Примеры ────────────────────────────────────────────────────
# Вариант A: Hiddify SOCKS5 на всё
#   GLOBAL_PROXY=socks5h://127.0.0.1:10808
#
# Вариант B: Hiddify HTTP на всё
#   GLOBAL_PROXY=http://127.0.0.1:10809
#
# Вариант C: только Telegram через прокси
#   TELEGRAM_PROXY=socks5h://127.0.0.1:10808
#
# Вариант D: ничего не указывать — бот подхватит HTTP_PROXY/HTTPS_PROXY
#   из окружения автоматически (trust_env=True для aiohttp)
GLOBAL_PROXY=
TELEGRAM_PROXY=
OPENAI_PROXY=

# ═══════════════════════════════════════════════════════════════
# Логи
# ═══════════════════════════════════════════════════════════════
LOG_LEVEL=INFO

# Process updates concurrently (true / false)
CONCURRENT_UPDATES=true

# Note: legacy business-logic settings (models, paths, anti-spam, etc.)
# still live in libs/config_legacy.py. They will be migrated to plugins.toml
# in subsequent iterations as we touch the internals of each plugin.
