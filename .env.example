# ═══════════════════════════════════════════════════════════════
# TELEGRAM BOT
# ═══════════════════════════════════════════════════════════════
TELEGRAM_BOT_TOKEN=your-bot-token-here
ADMIN_CHAT_ID=-1001234567890

# ═══════════════════════════════════════════════════════════════
# LLM API — any OpenAI-compatible provider
# ═══════════════════════════════════════════════════════════════
# Поддерживается ЛЮБОЙ OpenAI-совместимый API: OpenAI, OpenRouter,
# Together, Groq, DeepSeek, Anyscale, LM Studio, Ollama (OpenAI compat),
# vLLM, LocalAI, и т.д. — везде, где есть /chat/completions.
#
# Примеры:
#   OpenAI:       OPENAI_BASE_URL=https://api.openai.com/v1
#   OpenRouter:   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   DeepSeek:     OPENAI_BASE_URL=https://api.deepseek.com/v1
#   Groq:         OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   Together:     OPENAI_BASE_URL=https://api.together.xyz/v1
#   LM Studio:    OPENAI_BASE_URL=http://localhost:1234/v1
#   Ollama:       OPENAI_BASE_URL=http://localhost:11434/v1
#
# Модели по умолчанию заданы в libs/config_legacy.py — переопредели их
# в этом файле при необходимости (MASTER_MODEL, DB_MODEL, и т.д.).
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# ═══════════════════════════════════════════════════════════════
# ПРОКСИ — чтобы не поднимать туннели
# ═══════════════════════════════════════════════════════════════
# Форматы URL:
#   http://host:port
#   http://user:pass@host:port
#   https://host:port
#   socks5://host:port            (DNS резолвится локально)
#   socks5h://host:port           (DNS через прокси — РЕКОМЕНДУЕТСЯ)
#   socks5://user:pass@host:port
#
# Логика резолва (по убыванию приоритета):
#   1. TELEGRAM_PROXY / OPENAI_PROXY  — точечно перекрывает GLOBAL
#   2. GLOBAL_PROXY                    — применяется и к TG, и к LLM
#   3. Системные env: ALL_PROXY > HTTPS_PROXY > HTTP_PROXY
#      (Hiddify/v2rayN/clash часто прописывают их сами при включении)
#   4. Прямое подключение
#
# Для SOCKS нужно один раз поставить:
#   pip install "httpx[socks]" aiohttp-socks
#
# ─── Hiddify / v2rayN на ПК ─────────────────────────────────────
# Типичные порты локального прокси-клиента:
#   10808 — SOCKS5  → GLOBAL_PROXY=socks5h://127.0.0.1:10808
#   10809 — HTTP    → GLOBAL_PROXY=http://127.0.0.1:10809
#   12334 — SOCKS5  (некоторые сборки v2rayN)
#   7890  — HTTP    (Clash)
#
# ─── Примеры ────────────────────────────────────────────────────
# Вариант A: Hiddify SOCKS5 на всё
#   GLOBAL_PROXY=socks5h://127.0.0.1:10808
#
# Вариант B: Hiddify HTTP на всё
#   GLOBAL_PROXY=http://127.0.0.1:10809
#
# Вариант C: только Telegram через прокси
#   TELEGRAM_PROXY=socks5h://127.0.0.1:10808
#
# Вариант D: ничего не указывать — бот подхватит HTTP_PROXY/HTTPS_PROXY
#   из окружения автоматически (trust_env=True для aiohttp)
GLOBAL_PROXY=
TELEGRAM_PROXY=
OPENAI_PROXY=

# ═══════════════════════════════════════════════════════════════
# Логи
# ═══════════════════════════════════════════════════════════════
LOG_LEVEL=INFO

# Process updates concurrently (true / false)
CONCURRENT_UPDATES=true

# Note: legacy business-logic settings (models, paths, anti-spam, etc.)
# still live in libs/config_legacy.py. They will be migrated to plugins.toml
# in subsequent iterations as we touch the internals of each plugin.

# ═══════════════════════════════════════════════════════════════
# ИТЕРАЦИЯ 10 — коммерческий режим / биллинг (Разделы 6-7)
# ═══════════════════════════════════════════════════════════════
# false (или не задано) — игра БЕСПЛАТНА везде: общий чат, ЛС, любые чаты.
# true — включается вся схема: общий чат (MAIN_CHAT_ID) бесплатен; ЛС
#   закрыта для игры для всех кроме TESTERS; другие чаты — токен-гейт
#   с реальным списанием (плагин plugins/billing/).
COMMERCIAL_MODE=false

# TESTERS — де-факто модераторы. Telegram user_id через запятую.
# Безлимитный баланс (токен-гейт на них не действует ни в каком чате),
# доступ к игре в ЛС + команда ручного пополнения /ychwanegu.
TESTERS=

# MAIN_CHAT_ID — «общий/главный чат бота» (бесплатная игра в
# commercial-режиме). 0 = не задан (все групповые чаты считаются платными).
MAIN_CHAT_ID=0

# Стартовый грант токенов новому игроку — РОВНО ОДИН РАЗ за аккаунт
# (глобально по user_id, не пересоздаётся при выходе/входе в сессию).
TOKEN_GRANT_AMOUNT=30000000

# ═══════════════════════════════════════════════════════════════
# ИТЕРАЦИЯ 10 — перебор провайдеров LLM (Раздел 8)
# ═══════════════════════════════════════════════════════════════
# Host+API = один «провайдер», под ним НЕСКОЛЬКО моделей. Пока на текущем
# провайдере не перепробованы ВСЕ модели — к следующему провайдеру перехода
# нет. Каждый вызов chat() начинает перебор ЗАНОВО с провайдера №1 (без
# памяти между запросами). Переключение: 401/402/403, исчерпание ретраев
# (429/5xx/сеть) или «средовая» ошибка провайдера — гео-блок («User location
# is not supported», FAILED_PRECONDITION), невалидный ключ, биллинг,
# suspended-аккаунт (ИТЕРАЦИЯ 11): провайдер пропускается ЦЕЛИКОМ, к
# следующему. Честная ошибка запроса (400/404 без этих паттернов) — наружу.
# Переопределение под роль: <ROLE>_PROVIDERS (MASTER_PROVIDERS, DB_PROVIDERS,
# RENDERER_PROVIDERS, MEMORY_PROVIDERS, EMBEDDING_PROVIDERS, NPC_AI_PROVIDERS,
# MODER_AI_PROVIDERS, MODER_AI_DISPATCH_PROVIDERS, AUDITOR_PROVIDERS,
# TRANSLATOR_PROVIDERS).
#
# LLM_PROVIDERS=[
#   {"name": "openrouter", "base_url": "https://openrouter.ai/api/v1",
#    "api_key": "sk-or-...",
#    "models": ["google/gemma-3-4b-it:free", "google/gemma-3-4b-it"]},
#   {"name": "polza", "base_url": "https://api.polza.ai/v1",
#    "api_key": "sk-polza-...", "models": ["google/gemma-3-4b-it"]}
# ]
LLM_PROVIDERS=
